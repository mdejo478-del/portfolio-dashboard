SESSION_SECRET=

# Telegram bot - sends a message to TELEGRAM_CHAT_ID whenever a new user signs up.
# Leave either empty to disable the notification (signup still works normally).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free API key from https://finnhub.io/register - used for live price refresh.
# Leave empty to disable live prices (the dashboard falls back gracefully).
FINNHUB_API_KEY=

# Resend (https://resend.com) - sends the "forgot password" reset link by
# email. Free tier: 3,000 emails/month. RESEND_FROM_EMAIL must be an address
# on a domain you've verified in Resend (or their sandbox onboarding@resend.dev
# for testing - check Resend's dashboard for its current sandbox limits).
# Leave either empty to disable: requesting a reset will silently no-op
# rather than error, matching FINNHUB_API_KEY's fallback pattern.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Canonical base URL used to build links in outgoing emails (password reset).
# Defaults to http://localhost:3000 if unset - set this to your real deployed
# URL (e.g. https://your-app.up.railway.app) in production, or reset links
# will point at localhost.
APP_BASE_URL=
